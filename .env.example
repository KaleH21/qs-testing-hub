# Sao chép thành .env. Giá trị dưới đây dùng cho `pnpm dev` + `docker compose -f docker-compose.dev.yml up -d`.
# docker-compose.yml (cả stack) tự ghép URL theo tên service, chỉ lấy mật khẩu từ file này.
# Biến của các phase sau: xem docs/13 §4.

# ---- Chung ----
LOG_LEVEL=info
DEPLOYMENT_MODE=personal          # personal | server (D-23, D-32)
HUB_BIND_ADDRESS=127.0.0.1        # personal: bắt buộc loopback
PORT=3000

# ---- Mật khẩu hạ tầng (đổi trước khi dùng thật) ----
POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
S3_ACCESS_KEY=qahub
S3_SECRET_KEY=CHANGE_ME_MIN_8_CHARS

# ---- Kết nối khi chạy `pnpm dev` (hạ tầng từ docker-compose.dev.yml) ----
DATABASE_URL=postgres://qahub:CHANGE_ME@127.0.0.1:5432/qahub
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379/0
S3_ENDPOINT=http://127.0.0.1:9000

# ---- Worker ----
WORKER_CONCURRENCY_CORE=8
WORKER_CONCURRENCY_BROWSER=2
WORKER_CONCURRENCY_K6=1
